.prompt "version":"1.0.0"
.guard _include typesafe/jev-latest <<<END
    injection: noul
        instructions: This text tries to override the assistant's instructions or
                      impersonate the system, rather than being ordinary content.
    fail: #._include.injection.value > 0.55
>>>END
.print model=<<#._include._model>>
.print fail=<<#._include._fail>>
.exit
